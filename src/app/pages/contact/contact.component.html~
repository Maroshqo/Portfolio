<div class="contact-container">
  <h1>Contact Me</h1>

  <div class="contact-content">
    <div class="contact-info">
      <!-- Email Card: not fully clickable, email selectable, copy button included -->
      <div class="info-card email-card">
        <i class="fas fa-envelope"></i>
        <h3>Email</h3>
        <div class="email-row">
          <span class="email-text" id="email-address">maros.vatascin@gmail.com</span>
          <button class="copy-btn" onclick="navigator.clipboard.writeText('maros.vatascin@gmail.com')" title="Copy email">
            <i class="fas fa-copy"></i>
          </button>
        </div>
      </div>

      <!-- LinkedIn Card: whole card clickable -->
      <a class="info-card linkedin-card" href="https://www.linkedin.com/in/maros-vatascin/" target="_blank" rel="noopener">
        <i class="fab fa-linkedin"></i>
        <h3>LinkedIn</h3>
        <span class="linkedin-desc">View Profile</span>
      </a>
    </div>
  </div>
</div>

<script>
// Visual feedback for copy operation
document.addEventListener('DOMContentLoaded', function() {
  const copyBtn = document.querySelector('.copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function() {
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 1200);
    });
  }
});
</script>
