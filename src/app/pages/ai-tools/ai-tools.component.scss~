.ai-tools-container {
  padding: 2rem;
  
  h1 {
    text-align: center;
    margin-bottom: 3rem;
    font-size: 2.5rem;
    background: linear-gradient(45deg, #00f2fe, #4facfe);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
}

.ai-tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto 3rem;
}

.ai-tool-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15px;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, #00f2fe10, #4facfe10);
    z-index: 0;
  }
  
  &:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    
    &::before {
      background: linear-gradient(45deg, #00f2fe20, #4facfe20);
    }
  }
  
  &.active {
    background: linear-gradient(45deg, #00f2fe20, #4facfe20);
    border: 2px solid #4facfe;
    transform: translateY(-5px);
    
    &::before {
      background: linear-gradient(45deg, #00f2fe30, #4facfe30);
    }
  }
  
  .tool-preview {
    padding: 3rem 2rem;
    text-align: center;
    position: relative;
    z-index: 1;
    
    i {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      background: linear-gradient(45deg, #00f2fe, #4facfe);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: #ffffff;
    }
    
    p {
      color: #b8b8b8;
    }
  }
}

.tool-details {
  max-width: 1200px;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  animation: slideIn 0.3s ease;
  
  .details-content {
    padding: 2rem;
    
    h2 {
      font-size: 2rem;
      margin-bottom: 2rem;
      background: linear-gradient(45deg, #00f2fe, #4facfe);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
    }
    
    .screenshot-gallery {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 20px;
      
      .gallery-thumbnail {
        width: 350px;
        height: 250px;
        object-fit: cover;
        border-radius: 6px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        cursor: pointer;
        
        &:hover {
          transform: scale(1.05);
          box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
        
        // Special styling for GIFs to make them more prominent
        &[src$=".gif"] {
          width: 450px;
          height: 320px;
          border: 2px solid rgba(79, 172, 254, 0.4);
        }
      }
    }
    
    .tool-description {
      color: #ffffff;
      
      p {
        margin-bottom: 2rem;
        line-height: 1.6;
      }
      
      .tech-stack,
      .ai-features {
        margin-bottom: 2rem;
        
        h3 {
          margin-bottom: 1rem;
          color: #4facfe;
        }
        
        ul {
          list-style: none;
          padding: 0;
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          
          li {
            background: rgba(255, 255, 255, 0.05);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            
            &::before {
              content: '•';
              margin-right: 0.5rem;
              color: #4facfe;
            }
          }
        }
      }
    }
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1200px) {
  .tool-details .details-content {
    .screenshot-gallery {
      .gallery-thumbnail {
        width: 300px;
        height: 220px;
        
        &[src$=".gif"] {
          width: 380px;
          height: 280px;
        }
      }
    }
  }
}

@media (max-width: 768px) {
  .ai-tools-grid {
    grid-template-columns: 1fr;
  }
  
  .tool-details .details-content {
    padding: 1rem;
    
    .screenshot-gallery {
      gap: 15px;
      
      .gallery-thumbnail {
        width: 280px;
        height: 200px;
        
        &[src$=".gif"] {
          width: 320px;
          height: 240px;
        }
      }
    }
  }
}

@media (max-width: 480px) {
  .tool-details .details-content {
    .screenshot-gallery {
      justify-content: center;
      
      .gallery-thumbnail {
        width: 100%;
        height: auto;
        max-height: 250px;
        
        &[src$=".gif"] {
          max-height: 280px;
        }
      }
    }
  }
}